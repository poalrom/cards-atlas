{
	"name": "cards-atlas",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite --host 0.0.0.0 --port 3010",
		"dev:local": "vite --mode local-data --host 0.0.0.0 --port 3010",
		"typecheck": "tsc --noEmit",
		"check": "biome check .",
		"build": "tsc --noEmit && vite build",
		"preview": "vite preview --host 0.0.0.0 --port 3010",
		"prepare:data": "node --env-file-if-exists=.env scripts/prepare/cli.ts",
		"catalog:import": "node --env-file-if-exists=.env --max-old-space-size=4096 scripts/prepare/cli.ts import",
		"catalog:preflight": "node --env-file-if-exists=.env scripts/prepare/cli.ts preflight",
		"catalog:analyze": "node --env-file-if-exists=.env scripts/prepare/cli.ts analyze",
		"catalog:publish": "node --env-file-if-exists=.env scripts/prepare/cli.ts publish",
		"publish": "npm run build && node scripts/publish.ts"
	},
	"dependencies": {
		"@fontsource-variable/geologica": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource/pt-serif": "^5.3.0",
		"@tanstack/react-router": "^1.168.10",
		"lucide-react": "^1.7.0",
		"react": "^19.2.4",
		"react-dom": "^19.2.4"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.10",
		"@tailwindcss/vite": "^4.2.2",
		"@tanstack/router-cli": "^1.167.12",
		"@tanstack/router-plugin": "^1.167.12",
		"@types/gh-pages": "^6.1.0",
		"@types/node": "^25.5.2",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.2.0",
		"gh-pages": "^6.3.0",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.2",
		"vite": "^8.0.5"
	}
}
